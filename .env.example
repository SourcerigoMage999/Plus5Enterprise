# Copy to .env and replace every value before starting Docker Compose.
# Local Compose passwords must satisfy SQL Server complexity rules and must not contain ' or ;.
PLUS5_SQL_SA_PASSWORD=
PLUS5_SQL_MIGRATION_PASSWORD=
PLUS5_SQL_APP_PASSWORD=

# Optional paid external AI integration. PLUS 5 keeps it disabled by default,
# performs no OpenAI calls and incurs no AI cost until the server owner enables it.
PLUS5_PRESENTATION_AI_ENABLED=false
PLUS5_OPENAI_API_KEY=

# Local Docker Compose uses isolated test credentials for its loopback-only S3 emulator.
# Production Cloudflare R2 credentials belong in the deployment secrets layer, never Git.
